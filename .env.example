# URL de conexão do PostgreSQL.
# No Railway: aba do plugin PostgreSQL > Connect > "Postgres Connection URL".
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Segredo usado para assinar os tokens JWT. Troque por uma string longa e aleatória.
JWT_SECRET=troque_por_um_segredo_forte_e_aleatorio

# Porta em que o servidor Express sobe. O Railway injeta a própria PORT automaticamente.
PORT=3000

# Opcional: chave compartilhada para proteger as rotas usadas pela Lanna
# (/api/disponibilidade, /api/agendar, /api/triagens, /api/conversas).
# Se deixada em branco, essas rotas ficam abertas (sem autenticação),
# como pedido originalmente. Se definida aqui, a Lanna deve enviar o
# mesmo valor no header "x-lanna-key" em toda requisição.
LANNA_API_KEY=
